# PLACEHOLDERS ONLY. Never use this file as a working secret file.
# Inject backend values through the deployment secret manager.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://REPLACE_USER:REPLACE_PASSWORD@db.example.invalid:5432/pixshare?ssl=verify-full
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=15
READINESS_TIMEOUT=3
UPLOADS_DIR=/app/uploads
ALLOWED_HOSTS=api.example.invalid
CORS_ORIGINS=https://app.example.invalid
CLERK_AUTHORIZED_PARTIES=https://app.example.invalid
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_JWT_KEY=
API_MAX_BODY_BYTES=11534336
REQUEST_BODY_TIMEOUT=30
API_READ_LIMIT=300
API_WRITE_LIMIT=60
STORAGE_PROVIDER=s3
S3_BUCKET=replace-with-private-production-bucket
S3_PREFIX=pixshare/media
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=https://media.example.invalid
S3_ADDRESSING_STYLE=auto
# Prefer the server IAM role; explicit temporary credentials stay server-side.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
S3_MAX_ATTEMPTS=3
# Frontend: public values must be present at BUILD time.
PIXSHARE_ENVIRONMENT=production
NEXT_PUBLIC_API_URL=https://api.example.invalid
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/me
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/me
# Frontend runtime also needs CLERK_SECRET_KEY and CLERK_AUTHORIZED_PARTIES.
# Example production Compose inputs, not application secrets.
PIXSHARE_API_IMAGE=REPLACE_REGISTRY/pixshare-api:REPLACE_IMMUTABLE_RELEASE
PIXSHARE_WEB_IMAGE=REPLACE_REGISTRY/pixshare-web:REPLACE_IMMUTABLE_RELEASE
PIXSHARE_API_ENV_FILE=.env.production
PIXSHARE_UPLOADS_VOLUME=REPLACE_EXISTING_UPLOADS_VOLUME
# Trust only the actual ingress IP/CIDR; never use '*' on a reachable API.
FORWARDED_ALLOW_IPS=REPLACE_INGRESS_IP_OR_CIDR
