NEXT_PUBLIC_API_URL=http://localhost:8000
# Use the publishable key from the SAME Clerk instance as the API secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/me
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/me

# Browser tests: put these in ignored .env.e2e.local, using dedicated dev users.
# E2E_USER_EMAIL=owner+clerk_test@example.com
# E2E_OTHER_USER_EMAIL=other+clerk_test@example.com
# E2E_REQUIRE_AUTH=1 prevents missing configuration from being reported as skips.
