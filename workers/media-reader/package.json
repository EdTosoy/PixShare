{
  "name": "media-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only delivery of PixShare images from a private R2 bucket",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24" },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
