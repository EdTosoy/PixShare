# Copy privately to /etc/pixshare/compose.env, chmod 0600. Never source untrusted files.
# Registry digests are populated after a fresh vulnerability scan.
PIXSHARE_API_IMAGE=ghcr.io/edtosoy/pixshare-api@sha256:REPLACE_SCANNED_RELEASE_DIGEST
PIXSHARE_POSTGRES_IMAGE=postgres:17-alpine@sha256:eee6c6e1b0894fa4fe0075eb054af9fd1cf39a35321c2d4110626cfe506411fb
PIXSHARE_API_ENV_FILE=/etc/pixshare/api.env
PIXSHARE_BACKUP_ENV_FILE=/etc/pixshare/backup.env
PIXSHARE_POSTGRES_PASSWORD_FILE=/etc/pixshare/postgres_password
PIXSHARE_APP_PASSWORD_FILE=/etc/pixshare/app_password
ACME_EMAIL=REPLACE_CERTIFICATE_CONTACT
PIXSHARE_INGRESS_SUBNET=172.30.80.0/28
PIXSHARE_CADDY_IP=172.30.80.2
