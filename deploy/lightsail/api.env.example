# Private /etc/pixshare/api.env, root-owned 0600. Real values never enter Terraform.
ENVIRONMENT=production
# Same-VM, isolated Docker network; no public PostgreSQL port. URL-encode the password.
DATABASE_URL=postgresql+asyncpg://pixshare:REPLACE_APP_PASSWORD@postgres:5432/pixshare
DATABASE_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=15
READINESS_TIMEOUT=3
ALLOWED_HOSTS=api.pixshare.edtosoy.com
CORS_ORIGINS=https://pixshare.edtosoy.com
CLERK_AUTHORIZED_PARTIES=https://pixshare.edtosoy.com
CLERK_SECRET_KEY=sk_live_REPLACE_ME
API_MAX_BODY_BYTES=11534336
REQUEST_BODY_TIMEOUT=30
API_READ_LIMIT=300
API_WRITE_LIMIT=60
STORAGE_PROVIDER=s3
S3_BUCKET=REPLACE_TERRAFORM_MEDIA_BUCKET
S3_PREFIX=pixshare/demo
S3_REGION=ap-southeast-1
S3_PUBLIC_BASE_URL=https://REPLACE_DISTRIBUTION.cloudfront.net
S3_ACCESS_KEY_ID=REPLACE_OUT_OF_BAND_APPLICATION_KEY
S3_SECRET_ACCESS_KEY=REPLACE_OUT_OF_BAND_APPLICATION_SECRET
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
S3_MAX_ATTEMPTS=3
