{
	email {$ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 60s
		}
	}
}

{$API_DOMAIN} {
	request_body {
		max_size 11534336
	}
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy api:8000 {
		header_up Host {$API_DOMAIN}
		header_up X-Forwarded-Host {$API_DOMAIN}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 45s
			keepalive 4s
		}
	}
	# Access logging stays off: request URLs can contain private information.
}
