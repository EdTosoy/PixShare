{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyStagingMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET-staging/pixshare/staging/*"
    },
    {
      "Sid": "OnlyStagingPrefixInventory",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET-staging",
      "Condition": {"StringLike": {"s3:prefix": ["pixshare/staging/*"]}}
    }
  ]
}
